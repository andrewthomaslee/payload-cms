# SealedSecret template for the payload-cms application environment.
#
# The sealed-secrets controller PEM is not yet deployed at
# https://sealed-secrets.borg.external.systems/cert/v1 — until then this file
# stays a template and MUST NOT be applied.
#
# Once the cert is live:
#
#   curl -fsS https://sealed-secrets.borg.external.systems/cert/v1 \
#     -o /tmp/borg-sealed-secrets.pem
#   kubeseal --controller-namespace kube-system \
#     --cert /tmp/sealed-secrets.pem \
#     --secret-name payload-cms-env \
#     --namespace payload-cms-production \
#     --env-file <(printf 'PAYLOAD_SECRET=%s\nCRON_SECRET=%s\nPREVIEW_SECRET=%s\nNEXT_PUBLIC_SERVER_URL=%s\n' ...) \
#     -o yaml > sealed-secret.yaml
#
# Then:
#   1. remove this .example file
#   2. add `sealed-secret.yaml` to kustomization.yaml resources
#   3. dispatch the release workflow
#
# Expected secret keys (see chart envFromSecret):
#   PAYLOAD_SECRET, CRON_SECRET, PREVIEW_SECRET
# NEXT_PUBLIC_SERVER_URL may live here too, or as plain chart `env`.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: payload-cms-env
  namespace: payload-cms-production
spec:
  encryptedData:
    PAYLOAD_SECRET: REPLACE_ME
    CRON_SECRET: REPLACE_ME
    PREVIEW_SECRET: REPLACE_ME