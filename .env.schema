# @required @sensitive @type=string()
CRON_SECRET="cron-secret"

# @required @sensitive @type=string(startsWith=mongodb://root)
DATABASE_URL="mongodb://root:password@mongodb.mongodb.svc.cluster.local:27017/?authSource=admin&directConnection=true"

# @required @type=url()
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# @required @sensitive @type=string()
PAYLOAD_SECRET="payload-secret"

# @required @sensitive @type=string()
PREVIEW_SECRET="preview-secret"

# @sensitive @type=string()
S3_ACCESS_KEY="s3-access-key"

# @sensitive @type=string()
S3_BUCKET_NAME="s3-bucket-name"

# @sensitive @type=string()
S3_ENDPOINT="s3-endpoint"

# @sensitive @type=string()
S3_REGION="s3-region"

# @sensitive @type=string()
S3_SECRET_KEY="s3-secret-key"